# OpenAI API Key for B2B Diamond Realtime Voice Agent
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Settings
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=ash

# SMTP Configuration for Sending Verification OTP & Diamond Catalog Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
